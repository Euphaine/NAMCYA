@page "/judge-portal"
@rendermode InteractiveServer
@inject AppDbContext Db
@using Microsoft.EntityFrameworkCore
@using System.Globalization
@using EventScoringSystem.Data
@using EventScoringSystem.Models
@inject NavigationManager Navigation

<div class="judge-portal-root">
    
    <!-- Top Branding & Welcome Banner Display (Only shown when NOT logged in) -->
    @if (!isLoggedIn)
    {
        <div class="container py-4">
            <div class="row justify-content-center">
                <div class="col-12 col-md-8 col-lg-6">
                    <div class="md-card overflow-hidden shadow-sm">
                        <div class="position-relative">
                            <img src="/images/banner.png" alt="Event Banner" class="w-100 md-banner-img" onerror="this.style.display='none'" />
                            <div class="md-banner-overlay p-4 text-center">
                                <img src="/images/logo.png" alt="System Logo" class="md-logo mb-2" onerror="this.style.display='none'" />
                                <h3 class="fw-bold md-title mb-1">Judge Scoring Portal</h3>
                                <p class="text-muted small mb-0 fw-medium">National Musical Competitions For Young Artists (NAMCYA)</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- PIN Login Card -->
            <div class="row justify-content-center mt-3">
                <div class="col-12 col-md-8 col-lg-6">
                    <div class="md-card overflow-hidden shadow-sm">
                        <div class="md-header py-3 text-center">
                            <h5 class="mb-0 fw-bold"><i class="bi bi-shield-lock-fill me-2"></i>Judge Authentication</h5>
                        </div>
                        <div class="card-body p-4 p-md-5">
                            <div class="mb-4 text-center">
                                <div class="md-icon-circle mx-auto mb-3">
                                    <i class="bi bi-key-fill fs-3 text-primary"></i>
                                </div>
                                <label class="form-label fw-semibold text-secondary">Enter Your 6-Digit PIN</label>
                                <input @bind="enteredPin" type="password" maxlength="6" class="form-control form-control-lg text-center font-monospace md-input fs-3 shadow-none" placeholder="------" />
                            </div>
                            
                            @if (!string.IsNullOrEmpty(loginError))
                            {
                                <div class="alert alert-danger py-2 mb-3 text-center small rounded-3 border-0 bg-danger bg-opacity-10 text-danger">
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i> @loginError
                                </div>
                            }

                            <button class="btn md-btn-primary w-100 py-3 fw-bold rounded-pill shadow-none" @onclick="AuthenticateJudge">
                                Access Scoring Sheet <i class="bi bi-arrow-right ms-1"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Welcome Banner Drawover Modal Animation -->
        @if (showWelcomeOverlay)
        {
            <div class="welcome-overlay-backdrop @(isOverlayFadingOut ? "fade-out" : "")">
                <div class="welcome-overlay-card text-center p-4 p-md-5">
                    <img src="/images/logo.png" alt="Logo" class="md-logo mb-3" onerror="this.style.display='none'" />
                    <div class="banner-drawover-wrapper mb-4 rounded-4 overflow-hidden shadow-sm">
                        <img src="/images/banner.png" alt="Welcome Banner" class="w-100 banner-drawover-img" onerror="this.style.display='none'" />
                    </div>
                    <h2 class="fw-bold text-dark mb-2">Welcome, @currentJudge?.Name!</h2>
                    <p class="text-secondary fw-medium mb-4">You are securely logged into <span class="text-dark fw-bold">@currentEvent?.Title</span></p>
                    <button class="btn md-btn-submit px-5 py-3 fw-bold rounded-pill shadow-none fs-5" @onclick="DismissWelcomeOverlay">
                        Start Scoring <i class="bi bi-arrow-right ms-2"></i>
                    </button>
                </div>
            </div>
        }

        <!-- Active Session Header Bar -->
        <div class="container-fluid bg-white border-bottom sticky-top py-3 px-3 px-md-4 shadow-2xs">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
                <div class="d-flex align-items-center gap-3 text-center text-md-start">
                    <img src="/images/logo.png" alt="Logo" style="height: 40px;" onerror="this.style.display='none'" />
                    <div>
                        <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-1 rounded-pill fw-bold mb-1 border-0">
                            <i class="bi bi-award-fill me-1"></i> Active Session
                        </span>
                        <h5 class="mb-0 fw-bold text-dark">@currentEvent?.Title</h5>
                    </div>
                </div>
                <div class="d-flex flex-wrap align-items-center justify-content-center gap-2">
                    <span class="text-secondary small fw-medium me-2"><i class="bi bi-person-badge me-1"></i> Judge: <span class="text-dark fw-bold">@currentJudge?.Name</span></span>
                    
                    <button class="btn btn-outline-secondary fw-semibold px-3 py-2 rounded-pill bg-light border-0" @onclick="TogglePersonalRanking">
                        <i class="bi @(showPersonalRanking ? "bi-table" : "bi-bar-chart-steps") me-1"></i> 
                        @(showPersonalRanking ? "Score Sheet" : "My Rankings")
                    </button>

                    <button class="btn md-btn-submit fw-bold px-3 py-2 rounded-pill shadow-none" @onclick="SubmitScores">
                        <i class="bi bi-check2-all me-1"></i> Submit
                    </button>
                    
                    <button class="btn btn-outline-danger fw-semibold px-3 py-2 rounded-pill bg-light border-0" @onclick="Logout">
                        <i class="bi bi-box-arrow-right me-1"></i> Logout
                    </button>
                </div>
            </div>
        </div>

        <div class="container-fluid px-3 px-md-4 py-4">
            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="row justify-content-center mb-4">
                    <div class="col-12 col-xxl-10">
                        <div class="alert md-alert-success alert-dismissible fade show rounded-3 mb-0 border-0 shadow-none" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i> @successMessage
                            <button type="button" class="btn-close" @onclick="() => successMessage = string.Empty"></button>
                        </div>
                    </div>
                </div>
            }

            @if (contestants == null || !contestants.Any() || criteria == null || !criteria.Any())
            {
                <div class="row justify-content-center">
                    <div class="col-12 col-xxl-10">
                        <div class="alert md-alert-warning rounded-3 p-4 border-0 shadow-none">
                            <i class="bi bi-exclamation-circle-fill me-2"></i> The administrator has not finished setting up contestants or criteria for this event yet.
                        </div>
                    </div>
                </div>
            }
            else if (showPersonalRanking)
            {
                <!-- Personal Ranking / Tie-Breaker View Card -->
                <div class="row justify-content-center">
                    <div class="col-12 col-xxl-10">
                        <div class="md-card rounded-4 mb-5 overflow-hidden shadow-sm">
                            <div class="md-table-header py-3 px-4 d-flex flex-wrap justify-content-between align-items-center gap-2">
                                <div>
                                    <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-bar-chart-steps me-2 text-primary"></i>Your Personal Standings & Ranks</h5>
                                    <p class="text-muted small mb-0">Review computed totals per contestant to spot and resolve ties.</p>
                                </div>
                                <span class="badge bg-primary text-white px-3 py-2 rounded-pill fw-medium">
                                    <i class="bi bi-shield-check me-1"></i> Judge: @currentJudge?.Name
                                </span>
                            </div>
                            
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-hover mb-0 align-middle md-table">
                                        <thead class="md-thead">
                                            <tr>
                                                <th class="text-center py-3 ps-4" style="width: 90px;">Rank</th>
                                                <th class="text-start py-3">Contestant</th>
                                                <th class="text-center py-3">Breakdown Calculation</th>
                                                <th class="text-center py-3 pe-4" style="min-width: 140px;">Total Score</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{
                                                var rankedContestants = contestants.Select(c => {
                                                    decimal total = 0;
                                                    foreach (var crit in criteria)
                                                    {
                                                        var scoreRec = existingScores.FirstOrDefault(s => s.ContestantId == c.Id && s.CriterionId == crit.Id);
                                                        total += scoreRec?.ScoreValue ?? 0;
                                                    }
                                                    return new { Contestant = c, TotalScore = total };
                                                })
                                                .OrderByDescending(x => x.TotalScore)
                                                .ToList();

                                                int rank = 1;
                                                decimal? lastScore = null;
                                                int displayRank = 1;
                                            }

                                            @foreach (var item in rankedContestants)
                                            {
                                                if (lastScore == null || item.TotalScore != lastScore)
                                                {
                                                    displayRank = rank;
                                                    lastScore = item.TotalScore;
                                                }
                                                rank++;

                                                <tr>
                                                    <td class="text-center fw-bold ps-4">
                                                        <span class="badge @(displayRank == 1 ? "bg-warning text-dark" : "bg-light text-secondary border") fs-6 px-3 py-2 rounded-pill">
                                                            #@displayRank
                                                        </span>
                                                    </td>
                                                    <td class="fw-semibold py-3">
                                                        <div class="d-flex align-items-center gap-3">
                                                            <div class="md-contestant-badge font-monospace">
                                                                #@item.Contestant.ContestantNumber
                                                            </div>
                                                            <div>
                                                                <div class="fw-bold text-dark">@item.Contestant.Name</div>
                                                                @if (!string.IsNullOrWhiteSpace(item.Contestant.Region))
                                                                {
                                                                    <div class="text-muted small"><i class="bi bi-geo-alt-fill text-danger me-1"></i>@item.Contestant.Region</div>
                                                                }
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td class="text-center text-muted small">
                                                        @foreach (var crit in criteria)
                                                        {
                                                            var sRec = existingScores.FirstOrDefault(s => s.ContestantId == item.Contestant.Id && s.CriterionId == crit.Id);
                                                            <span class="me-2">@crit.Name: <strong>@(sRec?.ScoreValue ?? 0)</strong></span>
                                                        }
                                                    </td>
                                                    <td class="text-center pe-4">
                                                        <span class="font-monospace fw-bold text-primary fs-5 px-3 py-1 bg-primary bg-opacity-10 rounded-pill">
                                                            @item.TotalScore.ToString("0.##", CultureInfo.InvariantCulture)
                                                        </span>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <!-- Scoring Interface Grid Cards (Optimized for iPad / Touch Tablets) -->
                <div class="row justify-content-center">
                    <div class="col-12 col-xxl-10">
                        <div class="d-flex justify-content-between align-items-center mb-3 px-1">
                            <h5 class="fw-bold text-dark mb-0"><i class="bi bi-sliders me-2 text-primary"></i>Official Score Sheet</h5>
                            <span class="badge bg-light text-secondary border px-3 py-2 rounded-pill fw-medium">
                                <i class="bi bi-tablet me-1"></i> Touch Optimized View
                            </span>
                        </div>

                        <div class="row g-3">
                            @foreach (var c in contestants)
                            {
                                <div class="col-12 col-xl-6">
                                    <div class="md-card p-3 p-md-4 rounded-4 shadow-2xs h-100 bg-white border">
                                        <!-- Contestant Header -->
                                        <div class="d-flex align-items-center justify-content-between pb-3 mb-3 border-bottom">
                                            <div class="d-flex align-items-center gap-3">
                                                <div class="md-contestant-badge font-monospace fs-5 px-3 py-2">
                                                    #@c.ContestantNumber
                                                </div>
                                                <div>
                                                    <h5 class="fw-bold text-dark mb-0">@c.Name</h5>
                                                    @if (!string.IsNullOrWhiteSpace(c.Region))
                                                    {
                                                        <span class="text-muted small"><i class="bi bi-geo-alt-fill text-danger me-1"></i>@c.Region</span>
                                                    }
                                                </div>
                                            </div>
                                            <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill font-monospace fw-bold">
                                                Total: @GetContestantTotal(c.Id).ToString("0.##", CultureInfo.InvariantCulture)
                                            </span>
                                        </div>

                                        <!-- Criteria Sliders Stack -->
                                        <div class="d-flex flex-column gap-3">
                                            @foreach (var crit in criteria)
                                            {
                                                <div class="p-3 bg-light bg-opacity-50 rounded-4 border">
                                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                                        <span class="fw-bold text-dark small">@crit.Name</span>
                                                        <div class="d-flex align-items-center gap-2">
                                                            <span class="text-muted" style="font-size: 0.75rem;">Max: @crit.Percentage.ToString("0.##", CultureInfo.InvariantCulture)</span>
                                                            <input type="number" 
                                                                   min="0" 
                                                                   max="@crit.Percentage.ToString(CultureInfo.InvariantCulture)" 
                                                                   step="0.01"
                                                                   class="form-control form-control-sm text-center font-monospace fw-bold md-input" 
                                                                   style="width: 75px;"
                                                                   value="@GetFormattedScore(c.Id, crit.Id)"
                                                                   @onchange="@(e => UpdateScore(c.Id, crit.Id, e.Value))" />
                                                        </div>
                                                    </div>
                                                    <!-- Touch-friendly Range Slider -->
                                                    <input type="range" 
                                                           min="0" 
                                                           max="@crit.Percentage.ToString(CultureInfo.InvariantCulture)" 
                                                           step="0.01"
                                                           class="form-range md-range w-100"
                                                           value="@GetFormattedScore(c.Id, crit.Id)"
                                                           @oninput="@(e => UpdateScore(c.Id, crit.Id, e.Value))" />
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .judge-portal-root {
        background-color: #f8f9fc;
        min-height: 100vh;
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }
    .md-title { color: #1a1c1e; }
    .md-logo { max-height: 55px; object-fit: contain; }
    .md-card {
        border-radius: 20px;
        background-color: #ffffff;
        border: 1px solid #e3e8ef;
    }
    .md-header {
        background: #f1f4f9;
        color: #1a1c1e;
        border-top-left-radius: 20px;
        border-top-right-radius: 20px;
        border-bottom: 1px solid #e3e8ef;
    }
    .md-banner-img { max-height: 160px; object-fit: cover; }
    .md-banner-overlay {
        background: linear-gradient(to bottom, rgba(255,255,255,0.9), rgba(255,255,255,0.98));
        backdrop-filter: blur(6px);
    }
    .md-table-header { background-color: #f8f9fc; border-bottom: 1px solid #e3e8ef; }
    .md-thead { background-color: #f1f4f9; }
    .md-btn-primary { background-color: #0b57d0; color: #ffffff; border: none; }
    .md-btn-primary:hover { background-color: #0842a0; color: #ffffff; }
    .md-btn-submit { background-color: #0f9d58; color: #ffffff; border: none; }
    .md-btn-submit:hover { background-color: #0b8043; color: #ffffff; }
    .md-alert-success { background-color: #e6f4ea; color: #137333; }
    .md-alert-warning { background-color: #fef7e0; color: #b06000; }
    .md-input { border-color: #c4c7c5; background-color: #f8f9fa; border-radius: 8px; }
    .md-contestant-badge {
        background-color: #f1f3f4;
        color: #3c4043;
        font-weight: 700;
        border-radius: 10px;
    }
    .md-icon-circle {
        width: 64px; height: 64px;
        background-color: #e8f0fe;
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
    }
    .md-range {
        accent-color: #0b57d0;
        height: 8px;
        cursor: pointer;
        background: #e0e2e0;
        border-radius: 4px;
    }
    .welcome-overlay-backdrop {
        position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
        background-color: rgba(31, 31, 31, 0.6);
        backdrop-filter: blur(4px);
        z-index: 9999;
        display: flex; align-items: center; justify-content: center;
        animation: fadeInOverlay 0.3s ease forwards;
    }
    .welcome-overlay-backdrop.fade-out { animation: fadeOutOverlay 0.3s ease forwards; }
    .welcome-overlay-card {
        background: #ffffff; width: 90%; max-width: 550px;
        border-radius: 28px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
    }
    .banner-drawover-wrapper { width: 100%; max-height: 160px; overflow: hidden; border-radius: 12px; }
    .banner-drawover-img { width: 100%; height: 100%; object-fit: cover; }
    @@keyframes fadeInOverlay { from { opacity: 0; } to { opacity: 1; } }
    @@keyframes fadeOutOverlay { from { opacity: 1; } to { opacity: 0; } }
</style>

@code {
    private string enteredPin = "";
    private string loginError = "";
    private string successMessage = "";
    private bool isLoggedIn = false;
    private bool showWelcomeOverlay = false;
    private bool isOverlayFadingOut = false;
    private bool showPersonalRanking = false;

    [SupplyParameterFromQuery]
    public int? EventId { get; set; }

    [SupplyParameterFromQuery]
    public string? Pin { get; set; }

    private Judge? currentJudge;
    private EventItem? currentEvent;
    private List<Contestant> contestants = new();
    private List<Criterion> criteria = new();
    private List<Score> existingScores = new();

    protected override async Task OnParametersSetAsync()
    {
        if (!isLoggedIn && EventId.HasValue && !string.IsNullOrEmpty(Pin))
        {
            await AttemptAutoLogin(EventId.Value, Pin);
        }
    }

    private async Task AttemptAutoLogin(int eventId, string pin)
    {
        loginError = "";
        currentJudge = await Db.Judges.FirstOrDefaultAsync(j => j.EventId == eventId && j.PinCode == pin);
        if (currentJudge == null) { loginError = "Invalid QR login credentials."; return; }

        currentEvent = await Db.Events.FindAsync(currentJudge.EventId);
        if (currentEvent == null) { loginError = "Associated event not found."; return; }

        contestants = await Db.Contestants.Where(c => c.EventId == currentJudge.EventId).OrderBy(c => c.ContestantNumber).ToListAsync();
        criteria = await Db.Criteria.Where(cr => cr.EventId == currentJudge.EventId).OrderBy(cr => cr.Id).ToListAsync();
        existingScores = await Db.Scores.Where(s => s.JudgeId == currentJudge.Id).ToListAsync();

        isLoggedIn = true;
        showWelcomeOverlay = true;
    }

    private async Task AuthenticateJudge()
    {
        loginError = "";
        if (string.IsNullOrWhiteSpace(enteredPin) || enteredPin.Length != 6)
        {
            loginError = "Please enter a valid 6-digit PIN.";
            return;
        }

        currentJudge = await Db.Judges.FirstOrDefaultAsync(j => j.PinCode == enteredPin);
        if (currentJudge == null) { loginError = "Incorrect PIN code. Please try again."; return; }

        currentEvent = await Db.Events.FindAsync(currentJudge.EventId);
        if (currentEvent == null) { loginError = "Associated event not found."; return; }

        contestants = await Db.Contestants.Where(c => c.EventId == currentJudge.EventId).OrderBy(c => c.ContestantNumber).ToListAsync();
        criteria = await Db.Criteria.Where(cr => cr.EventId == currentJudge.EventId).OrderBy(cr => cr.Id).ToListAsync();
        existingScores = await Db.Scores.Where(s => s.JudgeId == currentJudge.Id).ToListAsync();

        isLoggedIn = true;
        showWelcomeOverlay = true;
    }

    private async Task DismissWelcomeOverlay()
    {
        isOverlayFadingOut = true;
        StateHasChanged();
        await Task.Delay(350);
        showWelcomeOverlay = false;
        isOverlayFadingOut = false;
        StateHasChanged();
    }

    private void TogglePersonalRanking() => showPersonalRanking = !showPersonalRanking;

    private string GetFormattedScore(int contestantId, int criterionId)
    {
        var scoreRecord = existingScores.FirstOrDefault(s => s.ContestantId == contestantId && s.CriterionId == criterionId);
        return (scoreRecord?.ScoreValue ?? 0).ToString(CultureInfo.InvariantCulture);
    }

    private decimal GetContestantTotal(int contestantId)
    {
        decimal total = 0;
        foreach (var crit in criteria)
        {
            var scoreRec = existingScores.FirstOrDefault(s => s.ContestantId == contestantId && s.CriterionId == crit.Id);
            total += scoreRec?.ScoreValue ?? 0;
        }
        return total;
    }

    private async Task UpdateScore(int contestantId, int criterionId, object? val)
    {
        if (val == null) return;
        if (decimal.TryParse(val.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out decimal parsedVal))
        {
            var crit = criteria.FirstOrDefault(c => c.Id == criterionId);
            if (crit != null && parsedVal > crit.Percentage) parsedVal = crit.Percentage;
            if (parsedVal < 0) parsedVal = 0;

            var scoreRecord = existingScores.FirstOrDefault(s => s.ContestantId == contestantId && s.CriterionId == criterionId);
            if (scoreRecord != null)
            {
                scoreRecord.ScoreValue = parsedVal;
                Db.Scores.Update(scoreRecord);
            }
            else
            {
                var newScore = new Score { JudgeId = currentJudge!.Id, ContestantId = contestantId, CriterionId = criterionId, ScoreValue = parsedVal };
                existingScores.Add(newScore);
                Db.Scores.Add(newScore);
            }
            await Db.SaveChangesAsync();
        }
    }

    private async Task SubmitScores()
    {
        successMessage = "Scores successfully saved and submitted!";
        StateHasChanged();
        await Task.Delay(3000);
        successMessage = "";
        StateHasChanged();
    }

    private void Logout()
    {
        isLoggedIn = false;
        currentJudge = null;
        currentEvent = null;
        enteredPin = "";
        showPersonalRanking = false;
        contestants.Clear();
        criteria.Clear();
        existingScores.Clear();
        Navigation.NavigateTo("/judge-portal", forceLoad: false);
    }
}